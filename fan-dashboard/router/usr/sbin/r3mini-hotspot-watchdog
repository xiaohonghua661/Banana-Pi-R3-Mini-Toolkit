#!/bin/sh
# Wi-Fi 上网自动重连：每 check_interval 秒检查一次。
#   连续 failure_limit 次没连上：ifup wwan
#   连续 3 轮重连无效、且过了冷却时间：用本机 AP 搜索（不停 AP），对方换了信道就让本机该频段跟过去
# 与页面共用 r3mini-hotspot-web 的函数和写锁；页面的保存任务在跑时不动手。

TAG='r3mini-hotspot'
R3MINI_HOTSPOT_LIB=1
. "${R3HS_WEB:-/usr/sbin/r3mini-hotspot-web}"

enabled() { [ "$(cfg enabled)" = 1 ]; }

follow_channel() {
	local radio ssid band found channel
	radio="$(uci -q get "wireless.$STA.device")"
	ssid="$(uci -q get "wireless.$STA.ssid")"
	[ -n "$radio" ] && [ -n "$ssid" ] || return 0
	band="$(radio_band "$radio")"
	found="$(find_network "$radio" "$ssid")" || { logger -t "$TAG" "wifi uplink not visible on $radio"; return 0; }
	channel="${found% *}"
	[ "$channel" != "$(uci -q get "wireless.$radio.channel")" ] || { logger -t "$TAG" "wifi uplink visible, channel unchanged"; return 0; }
	channel_supported "$band" "$channel" || { logger -t "$TAG" "wifi uplink moved to unsupported channel $channel"; return 0; }
	take_lock "$WRITE_LOCK" || return 0
	logger -t "$TAG" "wifi uplink moved to channel $channel; aligning $radio"
	if uci set "wireless.$radio.channel=$channel" && uci commit wireless; then
		uci set "$CONFIG.target_channel=$channel" && uci commit r3mini_hotspot
		wifi reconf "$radio" >/dev/null 2>&1 || logger -t "$TAG" "wifi reconf $radio failed"
	else
		uci -q revert wireless
		logger -t "$TAG" "channel update failed"
	fi
	drop_lock "$WRITE_LOCK"
}

interval="$(cfg check_interval)"; is_uint "$interval" && [ "$interval" -ge 5 ] && [ "$interval" -le 3600 ] || interval=20
limit="$(cfg failure_limit)"; is_uint "$limit" && [ "$limit" -ge 1 ] && [ "$limit" -le 20 ] || limit=3
cooldown="$(cfg cooldown)"; is_uint "$cooldown" && [ "$cooldown" -ge 30 ] && [ "$cooldown" -le 3600 ] || cooldown=180

failures=0
rounds=0
last_follow=0
backoff="$cooldown"

tick() {
	if ! enabled || lock_owner_alive "$JOB_LOCK"; then
		failures=0
		rounds=0
	elif wwan_ready; then
		failures=0
		rounds=0
		backoff="$cooldown"
	else
		failures=$((failures + 1))
		if [ "$failures" -ge "$limit" ]; then
			failures=0
			rounds=$((rounds + 1))
			logger -t "$TAG" "wifi uplink down; ifup wwan (round $rounds)"
			ifup wwan >/dev/null 2>&1
			now="$(date +%s)"
			if [ "$rounds" -ge 3 ] && [ $((now - last_follow)) -ge "$backoff" ]; then
				follow_channel
				last_follow="$now"
				rounds=0
				backoff=$((backoff * 2))
				[ "$backoff" -le 1800 ] || backoff=1800
			fi
		fi
	fi
}

[ "${R3HS_WATCHDOG_LIB:-0}" = 1 ] && return 0 2>/dev/null

while :; do
	tick
	sleep "$interval"
done
