{
	"luci-app-r3mini-hotspot": {
		"description": "上网出口：查看与切换出口、搜索并连接上游 Wi-Fi、暂停或恢复蜂窝拨号",
		"read": {
			"file": {
				"/usr/sbin/r3mini-hotspot-web": [ "exec" ]
			},
			"ubus": {
				"file": [ "exec" ]
			}
		},
		"write": {
			"file": {
				"/usr/sbin/r3mini-hotspot-web": [ "exec" ],
				"/tmp/r3mini-hotspot-key-*": [ "write", "remove" ]
			},
			"ubus": {
				"file": [ "exec", "write", "remove" ]
			}
		}
	}
}
