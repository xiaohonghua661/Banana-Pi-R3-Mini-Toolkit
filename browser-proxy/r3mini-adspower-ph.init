#!/bin/sh /etc/rc.common
START=99
STOP=10
USE_PROCD=1

start_service() {
    procd_open_instance
    procd_set_param command /usr/sbin/adspower-ph-start
    procd_set_param user root
    # OpenClash exempts gid 65534 from its own output interception. Match that gid
    # so this independent engine reaches its upstream without another proxy hop.
    procd_set_param group nogroup
    procd_set_param env SAFE_PATHS=/etc/ssl
    # The wrapper exits until the main runtime exists. procd retries at most 60
    # times, every 5 seconds, covering delayed OpenClash startup without a poll loop.
    procd_set_param respawn 300 5 60
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}

reload_service() {
    /etc/init.d/r3mini-adspower-ph restart
}

service_triggers() {
    procd_add_reload_trigger openclash
}
