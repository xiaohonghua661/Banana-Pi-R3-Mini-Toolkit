#!/bin/sh
# Raspberry Pi 5 side gateway: identity and LAN-safe defaults, applied once at first boot
# (uci-defaults runs from /etc/init.d/boot, before network starts, so the box never shows up
# as 192.168.1.1 with a DHCP server on the home LAN). The file deletes itself after exit 0.
uci -q batch <<'EOF'
set network.lan.proto='static'
set network.lan.ipaddr='192.168.0.247'
set network.lan.netmask='255.255.255.0'
set network.lan.gateway='192.168.0.254'
delete network.lan.dns
add_list network.lan.dns='192.168.0.254'
delete network.lan.ip6assign
set network.globals.ula_prefix='__ULA__'
set dhcp.lan.ignore='1'
set dhcp.lan.dhcpv4='disabled'
set dhcp.lan.dhcpv6='disabled'
set dhcp.lan.ra='disabled'
set dhcp.lan.ndp='disabled'
set system.@system[0].hostname='immortalwrt-rpi5'
set system.@system[0].zonename='Asia/Shanghai'
set system.@system[0].timezone='CST-8'
set system.ntp.enabled='1'
EOF
for z in $(uci -q show firewall | sed -n "s/^firewall\.\([^.]*\)\.name='lan'$/\1/p"); do
	uci set "firewall.$z.masq=1"
	uci set "firewall.$z.mtu_fix=1"
done
uci commit network
uci commit dhcp
uci commit system
uci commit firewall
exit 0
