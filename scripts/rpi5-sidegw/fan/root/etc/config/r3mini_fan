
config fan 'main'
	option sensor '/sys/class/thermal/thermal_zone0/temp'
	option mode '/sys/class/thermal/thermal_zone0/mode'
	option pwm '/sys/class/hwmon/hwmon2/pwm1'
	option pwm_enable '/sys/class/hwmon/hwmon2/pwm1_enable'
	option start_temp '50000'
	option medium_up '60000'
	option high_up '68000'
	option hysteresis '5000'
	option interval '5'
	option night_enabled '0'
	option night_start '00:00'
	option night_end '07:00'
	option night_override '75000'
