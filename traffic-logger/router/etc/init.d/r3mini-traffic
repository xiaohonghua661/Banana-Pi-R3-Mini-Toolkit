#!/bin/sh /etc/rc.common
# r3mini-traffic：按设备与目标记录经本路由器的代理流量（只读 OpenClash 控制接口与连接跟踪）
START=99
STOP=10
USE_PROCD=1

start_service() {
	[ "$(uci -q get r3mini_traffic.main.enabled)" = "1" ] || return 0
	procd_open_instance
	procd_set_param command /usr/sbin/r3mini-traffic run
	# 配置文件内容变了 procd 才会在 reload_config 时重启实例
	procd_set_param file /etc/config/r3mini_traffic
	# 小时与日期按路由器本地时区切分；/tmp/TZ 为空时不设，空 TZ 会让 musl 按 UTC 算
	[ -s /tmp/TZ ] && procd_set_param env TZ="$(cat /tmp/TZ)"
	procd_set_param respawn
	# 收到 SIGTERM 后要落盘，给足时间再 SIGKILL
	procd_set_param term_timeout 15
	procd_set_param stderr 1
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger r3mini_traffic
}
